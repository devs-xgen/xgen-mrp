# Direct Postgres connection string for backups (REQUIRED for Database Studio backups)
# Must be a standard postgresql:// URL, NOT a prisma+postgres URL.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PG_BACKUP_URL="postgresql://user:password@localhost:5432/xgen_mrp"

# Optional: Path to pg_dump if it's not available on PATH inside the runtime
# On Linux Docker image you may need to install postgresql-client and set this.
# On Windows, set to the installed pg_dump.exe path, e.g.,
#   C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe
PG_DUMP_PATH="pg_dump"

# Optional: Force SSL mode for pg_dump connections if your DB requires it
# Common values: require | verify-full
#PGSSLMODE=require

# Shareable Links Configuration
SHAREABLE_LINKS_DEFAULT_EXPIRY_DAYS=30
SHAREABLE_LINKS_MAX_PER_DOCUMENT=5
SHAREABLE_LINKS_RATE_LIMIT_PER_MINUTE=10
SHAREABLE_LINKS_TOKEN_LENGTH=32
SHAREABLE_LINKS_CLEANUP_INTERVAL_HOURS=24

# Company Information for Shared Documents
COMPANY_NAME="XGen Manufacturing"
COMPANY_ADDRESS="123 Manufacturing St, Industrial City, IC 12345"
COMPANY_PHONE="+1 (555) 123-4567"
COMPANY_EMAIL="info@xgenmanufacturing.com"
COMPANY_WEBSITE="https://xgenmanufacturing.com"

# Feature Flags
ENABLE_SHAREABLE_LINKS=true
ENABLE_LINK_ANALYTICS=true
ENABLE_AUTO_CLEANUP=true

# Security Settings
SHAREABLE_LINKS_REQUIRE_HTTPS=false
SHAREABLE_LINKS_IP_WHITELIST=""

# Error Handling & Debugging Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_ERROR_DEBUG=false
ENABLE_SOURCE_MAPS=false
ENABLE_PRODUCTION_STACK_TRACES=false