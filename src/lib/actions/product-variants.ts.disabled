"use server";

import { prisma } from "@/lib/prisma";
import { revalidatePath } from "next/cache";
import { convertDecimals } from "@/lib/convertDecimals";
import {
  CreateProductVariantInput,
  CreateProductVariantBOMInput,
  BulkCreateVariantsInput,
  ProductVariantForDisplay,
  VariantStatsResponse,
  VariantAPIResponse,
  BulkVariantCreationRequest,
  BulkVariantCreationResult,
  GroupedProductForDisplay,
  VariantBOMInheritance,
} from "@/types/admin/product-variants";

// =============================================
// PRODUCT VARIANT CREATION
// =============================================

export async function createProductVariant(
  data: CreateProductVariantInput
): Promise<VariantAPIResponse> {
  try {
    const sku = await generateVariantSKU(
      data.productId,
      data.sizeName,
      data.colorName
    );

    const variant = await prisma.productVariant.create({
      data: {
        ...data,
        sku,
      },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/products/${data.productId}`);

    return {
      success: true,
      data: convertDecimals(variant),
      message: "Product variant created successfully",
    };
  } catch (error: any) {
    console.error("Error creating product variant:", error);
    return {
      success: false,
      message: "Failed to create product variant",
      errors: [error.message],
    };
  }
}

export async function bulkCreateVariants(
  data: BulkCreateVariantsInput
): Promise<VariantAPIResponse> {
  return {
    success: false,
    message: "Bulk variant creation temporarily disabled - needs type fixes",
    errors: ["Function temporarily disabled"],
  };
}

// =============================================
// ENHANCED BULK VARIANT CREATION WITH BOM INHERITANCE
// =============================================

export async function createBulkProductVariants(
  request: BulkVariantCreationRequest
): Promise<BulkVariantCreationResult> {
  try {
    // Get base product with its BOMs
    const baseProduct = await prisma.product.findUnique({
      where: { id: request.productId },
      include: {
        boms: {
          include: {
            material: true,
          },
        },
      },
    });

    if (!baseProduct) {
      return {
        success: false,
        createdVariants: [],
        createdBOMs: 0,
        skippedVariants: [],
        totalCreated: 0,
        message: "Base product not found",
        errors: ["Product not found"],
      };
    }

    const createdVariants = [];
    const skippedVariants = [];
    let totalBOMsCreated = 0;

    // Create variants for each size + color combination
    for (const size of request.sizes) {
      for (const color of request.colors) {
        try {
          // Generate unique SKU
          const sku = `${baseProduct.sku}-${size.code}-${color.code}`;

          // Check if variant already exists
          const existingVariant = await prisma.productVariant.findUnique({
            where: { sku },
          });

          if (existingVariant) {
            skippedVariants.push({
              sizeName: size.name,
              colorName: color.name,
              reason: "Variant with this SKU already exists",
            });
            continue;
          }

          // Calculate variant pricing
          const sizeModifier = size.priceModifier || 1;
          const colorModifier = color.priceModifier || 1;
          const sizeCostModifier = size.costModifier || 1;
          const colorCostModifier = color.costModifier || 1;

          const variantCost =
            baseProduct.unitCost * sizeCostModifier * colorCostModifier;
          const variantPrice =
            baseProduct.sellingPrice * sizeModifier * colorModifier;

          // Create variant
          const variant = await prisma.productVariant.create({
            data: {
              productId: request.productId,
              sku,
              sizeName: size.name,
              sizeCode: size.code,
              colorName: color.name,
              colorCode: color.code,
              displayName: `${size.name} ${color.name}`,
              unitCost: variantCost,
              sellingPrice: variantPrice,
              minimumStockLevel: request.baseSettings.minimumStockLevel,
              currentStock: request.baseSettings.initialStock || 0,
              sortOrder: size.sortOrder || 0,
              inheritBOMFromParent: request.inheritBOM,
            },
          });

          // Create variant-specific BOMs if inheritance is enabled
          if (request.inheritBOM && baseProduct.boms.length > 0) {
            const bomCount = await createVariantBOMsFromParent(
              variant.id,
              baseProduct.boms,
              size.name,
              color.name,
              request.bomModifications
            );
            totalBOMsCreated += bomCount;
          }

          createdVariants.push(variant);
        } catch (error: any) {
          console.error(
            `Error creating variant ${size.name} ${color.name}:`,
            error
          );
          skippedVariants.push({
            sizeName: size.name,
            colorName: color.name,
            reason: error.message,
          });
        }
      }
    }

    // Update product to indicate it has variants
    if (createdVariants.length > 0) {
      await prisma.product.update({
        where: { id: request.productId },
        data: { hasVariants: true },
      });
    }

    revalidatePath("/admin/products");
    revalidatePath(`/admin/products/${request.productId}`);

    return {
      success: true,
      createdVariants,
      createdBOMs: totalBOMsCreated,
      skippedVariants,
      totalCreated: createdVariants.length,
      message: `Successfully created ${createdVariants.length} variants with ${totalBOMsCreated} BOM entries`,
    };
  } catch (error: any) {
    console.error("Error in bulk variant creation:", error);
    return {
      success: false,
      createdVariants: [],
      createdBOMs: 0,
      skippedVariants: [],
      totalCreated: 0,
      message: "Failed to create variants",
      errors: [error.message],
    };
  }
}

// =============================================
// BOM MANAGEMENT
// =============================================

export async function createProductVariantBOM(
  data: CreateProductVariantBOMInput
): Promise<VariantAPIResponse> {
  try {
    const bomEntry = await prisma.productVariantBOM.create({
      data,
      include: {
        material: true,
      },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/product-variants/${data.productVariantId}`);

    return {
      success: true,
      data: bomEntry,
      message: "BOM entry created successfully",
    };
  } catch (error: any) {
    console.error("Error creating variant BOM:", error);
    return {
      success: false,
      message: "Failed to create BOM entry",
      errors: [error.message],
    };
  }
}

export async function updateProductVariantBOM(
  bomId: string,
  data: Partial<CreateProductVariantBOMInput>
): Promise<VariantAPIResponse> {
  try {
    const bomEntry = await prisma.productVariantBOM.update({
      where: { id: bomId },
      data,
      include: {
        material: true,
      },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/product-variants/${bomEntry.productVariantId}`);

    return {
      success: true,
      data: bomEntry,
      message: "BOM entry updated successfully",
    };
  } catch (error: any) {
    console.error("Error updating variant BOM:", error);
    return {
      success: false,
      message: "Failed to update BOM entry",
      errors: [error.message],
    };
  }
}

export async function deleteProductVariantBOM(
  bomId: string
): Promise<VariantAPIResponse> {
  try {
    const bomEntry = await prisma.productVariantBOM.findUnique({
      where: { id: bomId },
    });

    if (!bomEntry) {
      return {
        success: false,
        message: "BOM entry not found",
      };
    }

    await prisma.productVariantBOM.delete({
      where: { id: bomId },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/product-variants/${bomEntry.productVariantId}`);

    return {
      success: true,
      message: "BOM entry deleted successfully",
    };
  } catch (error: any) {
    console.error("Error deleting variant BOM:", error);
    return {
      success: false,
      message: "Failed to delete BOM entry",
      errors: [error.message],
    };
  }
}

// =============================================
// VARIANT RETRIEVAL
// =============================================

export async function getProductVariants(productId: string) {
  try {
    const variants = await prisma.productVariant.findMany({
      where: {
        productId,
        isActive: true,
      },
      include: {
        boms: {
          include: {
            material: true,
          },
        },
        product: true,
      },
      orderBy: [
        { sortOrder: "asc" },
        { sizeName: "asc" },
        { colorName: "asc" },
      ],
    });

    return variants;
  } catch (error) {
    console.error("Error fetching product variants:", error);
    return [];
  }
}

export async function getProductVariantForDisplay(
  variantId: string
): Promise<ProductVariantForDisplay | null> {
  try {
    const variant = await prisma.productVariant.findUnique({
      where: { id: variantId },
      include: {
        boms: {
          include: {
            material: true,
          },
        },
      },
    });

    if (!variant) return null;

    // Calculate total material cost and format for display
    const bomsForDisplay = variant.boms.map((bom) => ({
      id: bom.id,
      materialId: bom.materialId,
      materialName: bom.material.name,
      materialSku: bom.material.sku,
      quantityNeeded: Number(bom.quantityNeeded),
      wastePercentage: Number(bom.wastePercentage),
      unitCost: Number(bom.material.costPerUnit),
      totalCost: Number(bom.quantityNeeded) * Number(bom.material.costPerUnit),
      notes: bom.notes,
    }));

    const totalMaterialCost = bomsForDisplay.reduce(
      (sum, bom) => sum + bom.totalCost,
      0
    );
    const availableStock = variant.currentStock - variant.committedStock;

    let stockStatus: "IN_STOCK" | "LOW_STOCK" | "OUT_OF_STOCK";
    if (availableStock <= 0) {
      stockStatus = "OUT_OF_STOCK";
    } else if (availableStock <= variant.minimumStockLevel) {
      stockStatus = "LOW_STOCK";
    } else {
      stockStatus = "IN_STOCK";
    }

    return {
      ...variant,
      unitCost: Number(variant.unitCost),
      sellingPrice: Number(variant.sellingPrice),
      boms: bomsForDisplay,
      totalMaterialCost,
      availableStock,
      stockStatus,
    };
  } catch (error) {
    console.error("Error fetching variant for display:", error);
    return null;
  }
}

export async function getVariantMatrix(productId: string) {
  try {
    const [product, variants] = await Promise.all([
      prisma.product.findUnique({
        where: { id: productId },
        select: { id: true, name: true },
      }),
      prisma.productVariant.findMany({
        where: {
          productId,
          isActive: true,
        },
        include: {
          boms: {
            include: {
              material: true,
            },
          },
        },
      }),
    ]);

    if (!product) return null;

    // Extract unique sizes and colors
    const sizes = [
      ...new Set(variants.map((v) => v.sizeName).filter(Boolean)),
    ].sort();
    const colors = [
      ...new Set(variants.map((v) => v.colorName).filter(Boolean)),
    ].sort();

    // Build variant matrix
    const variantMap: any = {};

    for (const variant of variants) {
      const key = `${variant.sizeName || "default"}-${variant.colorName || "default"}`;
      const totalCost = variant.boms.reduce(
        (sum, bom) =>
          sum + Number(bom.quantityNeeded) * Number(bom.material.costPerUnit),
        0
      );

      let stockStatus: "IN_STOCK" | "LOW_STOCK" | "OUT_OF_STOCK";
      const availableStock = variant.currentStock - variant.committedStock;

      if (availableStock <= 0) {
        stockStatus = "OUT_OF_STOCK";
      } else if (availableStock <= variant.minimumStockLevel) {
        stockStatus = "LOW_STOCK";
      } else {
        stockStatus = "IN_STOCK";
      }

      variantMap[key] = {
        variant,
        hasBOM: variant.boms.length > 0,
        totalCost,
        stockStatus,
      };
    }

    return {
      productId: product.id,
      productName: product.name,
      sizes,
      colors,
      variants: variantMap,
    };
  } catch (error) {
    console.error("Error fetching variant matrix:", error);
    return null;
  }
}

// =============================================
// VARIANT STATISTICS
// =============================================

export async function getVariantStats(
  productId?: string
): Promise<VariantStatsResponse> {
  try {
    const whereClause = productId ? { productId } : {};

    const [
      totalVariants,
      activeVariants,
      variantsWithBOM,
      lowStockVariants,
      outOfStockVariants,
      variants,
    ] = await Promise.all([
      prisma.productVariant.count({ where: whereClause }),
      prisma.productVariant.count({
        where: { ...whereClause, isActive: true },
      }),
      prisma.productVariant.count({
        where: {
          ...whereClause,
          boms: { some: {} },
        },
      }),
      prisma.productVariant.count({
        where: {
          ...whereClause,
          currentStock: { lte: prisma.productVariant.fields.minimumStockLevel },
          currentStock: { gt: 0 },
        },
      }),
      prisma.productVariant.count({
        where: {
          ...whereClause,
          currentStock: { lte: 0 },
        },
      }),
      prisma.productVariant.findMany({
        where: whereClause,
        select: {
          currentStock: true,
          unitCost: true,
        },
      }),
    ]);

    const totalValue = variants.reduce(
      (sum, variant) => sum + variant.currentStock * Number(variant.unitCost),
      0
    );

    return {
      totalVariants,
      activeVariants,
      variantsWithBOM,
      lowStockVariants,
      outOfStockVariants,
      totalValue,
    };
  } catch (error) {
    console.error("Error fetching variant stats:", error);
    return {
      totalVariants: 0,
      activeVariants: 0,
      variantsWithBOM: 0,
      lowStockVariants: 0,
      outOfStockVariants: 0,
      totalValue: 0,
    };
  }
}

// =============================================
// VARIANT MANAGEMENT
// =============================================

export async function updateProductVariant(
  variantId: string,
  data: Partial<CreateProductVariantInput>
): Promise<VariantAPIResponse> {
  try {
    const variant = await prisma.productVariant.update({
      where: { id: variantId },
      data: {
        ...data,
        updatedAt: new Date(),
      },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/product-variants/${variantId}`);

    return {
      success: true,
      data: variant,
      message: "Product variant updated successfully",
    };
  } catch (error: any) {
    console.error("Error updating product variant:", error);
    return {
      success: false,
      message: "Failed to update product variant",
      errors: [error.message],
    };
  }
}

export async function deleteProductVariant(
  variantId: string
): Promise<VariantAPIResponse> {
  try {
    // First delete all BOMs
    await prisma.productVariantBOM.deleteMany({
      where: { productVariantId: variantId },
    });

    // Then delete the variant
    const variant = await prisma.productVariant.delete({
      where: { id: variantId },
    });

    revalidatePath("/admin/products");
    revalidatePath(`/admin/products/${variant.productId}`);

    return {
      success: true,
      message: "Product variant deleted successfully",
    };
  } catch (error: any) {
    console.error("Error deleting product variant:", error);
    return {
      success: false,
      message: "Failed to delete product variant",
      errors: [error.message],
    };
  }
}

export async function adjustVariantStock(
  variantId: string,
  adjustment: number,
  reason?: string
): Promise<VariantAPIResponse> {
  try {
    const variant = await prisma.productVariant.findUnique({
      where: { id: variantId },
    });

    if (!variant) {
      return {
        success: false,
        message: "Product variant not found",
      };
    }

    const newStock = Math.max(0, variant.currentStock + adjustment);

    const updatedVariant = await prisma.productVariant.update({
      where: { id: variantId },
      data: {
        currentStock: newStock,
        updatedAt: new Date(),
      },
    });

    // TODO: Create inventory movement record for audit trail
    // This would be part of the full inventory management system

    revalidatePath("/admin/products");
    revalidatePath(`/admin/product-variants/${variantId}`);

    return {
      success: true,
      data: updatedVariant,
      message: `Stock adjusted by ${adjustment}. New stock: ${newStock}`,
    };
  } catch (error: any) {
    console.error("Error adjusting variant stock:", error);
    return {
      success: false,
      message: "Failed to adjust stock",
      errors: [error.message],
    };
  }
}

// =============================================
// UTILITY FUNCTIONS
// =============================================

async function generateVariantSKU(
  productId: string,
  sizeName?: string | null,
  colorName?: string | null
): Promise<string> {
  const product = await prisma.product.findUnique({
    where: { id: productId },
    select: { sku: true },
  });

  if (!product) {
    throw new Error("Product not found");
  }

  let sku = product.sku;

  if (sizeName) {
    sku += `-${sizeName.toUpperCase()}`;
  }

  if (colorName) {
    sku += `-${colorName.toUpperCase().replace(/\s+/g, "")}`;
  }

  // Ensure uniqueness
  let counter = 1;
  let finalSku = sku;

  while (await prisma.productVariant.findUnique({ where: { sku: finalSku } })) {
    finalSku = `${sku}-${counter}`;
    counter++;
  }

  return finalSku;
}

async function createVariantBOMs(
  variantId: string,
  materials: {
    materialId: string;
    quantityNeeded: number;
    wastePercentage: number;
  }[]
): Promise<void> {
  for (const material of materials) {
    await prisma.productVariantBOM.create({
      data: {
        productVariantId: variantId,
        materialId: material.materialId,
        quantityNeeded: material.quantityNeeded,
        wastePercentage: material.wastePercentage,
      },
    });
  }
}

// =============================================
// MIGRATION HELPERS
// =============================================

export async function migrateProductSizeVariantsToVariants(productId?: string) {
  try {
    const whereClause = productId ? { productId } : {};

    const sizeVariants = await prisma.productSizeVariant.findMany({
      where: {
        ...whereClause,
        isDeprecated: false,
      },
      include: {
        boms: true,
      },
    });

    for (const sizeVariant of sizeVariants) {
      // Create new ProductVariant
      const variant = await prisma.productVariant.create({
        data: {
          productId: sizeVariant.productId,
          sku: `${sizeVariant.productId}-${sizeVariant.sizeName}`,
          sizeName: sizeVariant.sizeName,
          sizeCode: sizeVariant.sizeCode,
          unitCost: sizeVariant.unitCost,
          sellingPrice: sizeVariant.sellingPrice,
          currentStock: sizeVariant.currentStock,
          minimumStockLevel: sizeVariant.minimumStockLevel,
          displayName: sizeVariant.sizeName,
          sortOrder: sizeVariant.sortOrder,
          isActive: sizeVariant.isActive,
        },
      });

      // Migrate BOMs
      for (const bom of sizeVariant.boms) {
        await prisma.productVariantBOM.create({
          data: {
            productVariantId: variant.id,
            materialId: bom.materialId,
            quantityNeeded: bom.quantityNeeded,
            wastePercentage: bom.wastePercentage,
          },
        });
      }

      // Mark old records as deprecated
      await prisma.productSizeVariant.update({
        where: { id: sizeVariant.id },
        data: { isDeprecated: true },
      });

      await prisma.productSizeVariantBOM.updateMany({
        where: { productSizeVariantId: sizeVariant.id },
        data: { isDeprecated: true },
      });
    }

    return {
      success: true,
      migratedCount: sizeVariants.length,
    };
  } catch (error) {
    console.error("Error migrating size variants:", error);
    return {
      success: false,
      error: error instanceof Error ? error.message : "Unknown error",
    };
  }
}

// =============================================
// BOM INHERITANCE FUNCTIONALITY
// =============================================

async function createVariantBOMsFromParent(
  variantId: string,
  parentBOMs: any[],
  sizeName: string,
  colorName: string,
  bomModifications?: BulkVariantCreationRequest["bomModifications"]
): Promise<number> {
  let createdCount = 0;

  for (const parentBOM of parentBOMs) {
    try {
      let adjustedQuantity = parentBOM.quantityNeeded;
      const wastePercentage = parentBOM.wastePercentage;

      // Apply BOM modifications if provided
      if (bomModifications) {
        const modification = bomModifications.find(
          (mod) => mod.materialId === parentBOM.materialId
        );

        if (modification) {
          // Apply general quantity modifier
          adjustedQuantity *= modification.quantityModifier;

          // Apply size-specific modifiers
          if (
            modification.sizeSpecific &&
            modification.sizeSpecific[sizeName]
          ) {
            adjustedQuantity *= modification.sizeSpecific[sizeName];
          }

          // Handle color-specific material substitutions
          if (
            modification.colorSpecific &&
            modification.colorSpecific[colorName]
          ) {
            const substituteMaterialId = modification.colorSpecific[colorName];
            // Use substitute material if different from original
            if (substituteMaterialId !== parentBOM.materialId) {
              parentBOM.materialId = substituteMaterialId;
            }
          }
        }
      }

      // Create variant BOM entry
      await prisma.productVariantBOM.create({
        data: {
          productVariantId: variantId,
          materialId: parentBOM.materialId,
          quantityNeeded: adjustedQuantity,
          wastePercentage,
          notes: `Inherited from parent product (${sizeName} ${colorName})`,
        },
      });

      createdCount++;
    } catch (error: any) {
      console.error(`Error creating BOM for variant ${variantId}:`, error);
    }
  }

  return createdCount;
}

// =============================================
// GROUPED PRODUCT DISPLAY
// =============================================

export async function getGroupedProductsWithVariants(): Promise<
  GroupedProductForDisplay[]
> {
  try {
    const products = await prisma.product.findMany({
      include: {
        category: true,
        variants: {
          include: {
            boms: {
              include: {
                material: true,
              },
            },
          },
        },
      },
      orderBy: [{ hasVariants: "desc" }, { name: "asc" }],
    });

    return products.map((product) => {
      const variants = product.variants.map((variant) => {
        const totalMaterialCost = variant.boms.reduce(
          (sum, bom) => sum + bom.quantityNeeded * bom.material.costPerUnit,
          0
        );

        return {
          ...variant,
          boms: variant.boms.map((bom) => ({
            id: bom.id,
            materialId: bom.materialId,
            materialName: bom.material.name,
            materialSku: bom.material.sku,
            quantityNeeded: bom.quantityNeeded,
            wastePercentage: bom.wastePercentage,
            unitCost: bom.material.costPerUnit,
            totalCost: bom.quantityNeeded * bom.material.costPerUnit,
            notes: bom.notes,
          })),
          totalMaterialCost,
          availableStock: variant.currentStock - variant.committedStock,
          stockStatus:
            variant.currentStock <= 0
              ? "OUT_OF_STOCK"
              : variant.currentStock <= variant.minimumStockLevel
                ? "LOW_STOCK"
                : "IN_STOCK",
        } as ProductVariantForDisplay;
      });

      const totalStock = variants.reduce((sum, v) => sum + v.currentStock, 0);
      const totalValue = variants.reduce(
        (sum, v) => sum + v.currentStock * v.unitCost,
        0
      );
      const lowStockVariants = variants.filter(
        (v) => v.stockStatus === "LOW_STOCK" || v.stockStatus === "OUT_OF_STOCK"
      ).length;

      return {
        id: product.id,
        name: product.name,
        sku: product.sku,
        description: product.description,
        hasVariants: product.hasVariants,
        variantCount: variants.length,
        totalStock,
        totalValue,
        lowStockVariants,
        category: {
          id: product.category.id,
          name: product.category.name,
        },
        variants,
        createdAt: product.createdAt,
        updatedAt: product.updatedAt,
      };
    });
  } catch (error: any) {
    console.error("Error fetching grouped products:", error);
    return [];
  }
}

// =============================================
// VARIANT BOM INHERITANCE TRACKING
// =============================================

export async function getVariantBOMInheritance(
  variantId: string
): Promise<VariantBOMInheritance | null> {
  try {
    const variant = await prisma.productVariant.findUnique({
      where: { id: variantId },
      include: {
        boms: {
          include: {
            material: true,
          },
        },
        product: {
          include: {
            boms: {
              include: {
                material: true,
              },
            },
          },
        },
      },
    });

    if (!variant) return null;

    const inheritedBOMs = variant.boms.map((variantBOM) => {
      const parentBOM = variant.product.boms.find(
        (pBOM) => pBOM.materialId === variantBOM.materialId
      );

      return {
        originalBOMId: parentBOM?.id || "",
        materialId: variantBOM.materialId,
        materialName: variantBOM.material.name,
        originalQuantity: parentBOM?.quantityNeeded || 0,
        adjustedQuantity: variantBOM.quantityNeeded,
        quantityModifier: parentBOM
          ? variantBOM.quantityNeeded / parentBOM.quantityNeeded
          : 1,
        reason: parentBOM
          ? variantBOM.quantityNeeded === parentBOM.quantityNeeded
            ? "NO_CHANGE"
            : "SIZE_ADJUSTMENT"
          : "VARIANT_SPECIFIC",
      };
    });

    return {
      variantId,
      parentProductId: variant.productId,
      inheritedBOMs,
    };
  } catch (error: any) {
    console.error("Error fetching variant BOM inheritance:", error);
    return null;
  }
}

// =============================================
// UTILITY FUNCTIONS
// =============================================

export async function getProductBOMsForInheritance(productId: string) {
  try {
    const product = await prisma.product.findUnique({
      where: { id: productId },
      include: {
        boms: {
          include: {
            material: true,
          },
        },
      },
    });

    if (!product) return null;

    return {
      productId: product.id,
      productName: product.name,
      boms: product.boms.map((bom) => ({
        id: bom.id,
        materialId: bom.materialId,
        materialName: bom.material.name,
        materialSku: bom.material.sku,
        quantityNeeded: Number(bom.quantityNeeded),
        wastePercentage: Number(bom.wastePercentage),
        unitCost: Number(bom.material.costPerUnit),
      })),
    };
  } catch (error: any) {
    console.error("Error fetching product BOMs:", error);
    return null;
  }
}
