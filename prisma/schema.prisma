generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                          @id @default(cuid())
  email                     String                          @unique
  password                  String
  role                      Role                            @default(WORKER)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  createdBy                 String?
  lastLoginAt               DateTime?
  modifiedBy                String?
  status                    UserStatus                      @default(ACTIVE)
  activityLogs              ActivityLog[]
  BillingStatement          BillingStatement[]              @relation("CreatedBillingStatements")
  modifiedBillingStatements BillingStatement[]              @relation("ModifiedBillingStatements")
  investigatedVariances     CostVariance[]
  deliveryAssignments       DeliveryAssignment[]
  createdDeliveryReceipts   DeliveryReceipt[]               @relation("CreatedDeliveryReceipts")
  modifiedDeliveryReceipts  DeliveryReceipt[]               @relation("ModifiedDeliveryReceipts")
  inspector                 Inspector?
  reportedIssues            InventoryIssueReport[]
  approvedMovements         InventoryMovement[]             @relation("ApprovedMovements")
  performedMovements        InventoryMovement[]             @relation("PerformedMovements")
  approvedMaterials         MaterialRequest[]               @relation("ApprovedMaterials")
  requestedMaterials        MaterialRequest[]               @relation("RequestedMaterials")
  assignedOperations        Operation[]                     @relation("AssignedOperations")
  performedOperations       Operation[]                     @relation("PerformedOperations")
  materialConsumptions      ProductionMaterialConsumption[]
  createdProductionOrders   ProductionOrder[]               @relation("CreatedBy")
  modifiedProductionOrders  ProductionOrder[]               @relation("ModifiedBy")
  productionHistoryLogs     ProductionOrderHistoryLog[]
  inspections               QualityCheck[]                  @relation("Inspections")
  createdSalesInvoices      SalesInvoice[]                  @relation("CreatedSalesInvoices")
  modifiedSalesInvoices     SalesInvoice[]                  @relation("ModifiedSalesInvoices")
  shareableLinks            ShareableLink[]
  Transaction               Transaction[]
  profile                   UserProfile?
  UserWorkCenter            UserWorkCenter[]
  workCenterAssignments     WorkCenterAssignment[]
  archivedOrders            CustomerOrderArchive[]          @relation("ArchivedOrders")
  restoredOrders            CustomerOrderArchive[]          @relation("RestoredOrders")
  supportTickets            SupportTicket[]                 @relation("UserSupportTickets")
  supportMessages           SupportMessage[]                @relation("UserSupportMessages")
}

model ProductionOrderHistoryLog {
  id                String          @id @default(cuid())
  productionOrderId String
  userId            String
  timestamp         DateTime        @default(now())
  status            Status?
  changeType        String
  notes             String?
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])

  @@index([productionOrderId])
  @@index([userId])
}

model WorkCenterAssignment {
  id           String     @id @default(cuid())
  userId       String
  workCenterId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       Status     @default(ACTIVE)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([userId, workCenterId])
}

model UserProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  department       String?
  position         String?
  employeeId       String?
  dateOfBirth      DateTime?
  gender           Gender?
  avatar           String?
  bio              String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emergencyContact EmergencyContact?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id             String      @id @default(cuid())
  profileId      String      @unique
  name           String
  relationship   String
  phoneNumber    String
  altPhoneNumber String?
  email          String?
  address        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userProfile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  modifiedBy  String?
  products    Product[]
}

model MaterialType {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  modifiedBy  String?
  materials   Material[]
}

model UnitOfMeasure {
  id          String     @id @default(cuid())
  name        String     @unique
  symbol      String
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  modifiedBy  String?
  materials   Material[]
}

model Product {
  id                       String                  @id @default(cuid())
  sku                      String                  @unique
  name                     String
  description              String?
  categoryId               String
  sizeRange                String[]
  colorOptions             String[]
  unitCost                 Decimal                 @db.Decimal(10, 2)
  sellingPrice             Decimal                 @db.Decimal(10, 2)
  minimumStockLevel        Int
  currentStock             Int
  expectedStock            Int                     @default(0)
  committedStock           Int                     @default(0)
  calculatedStock          Int                     @default(0)
  leadTime                 Int
  hasVariants              Boolean                 @default(false)
  status                   Status                  @default(ACTIVE)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  createdBy                String?
  modifiedBy               String?
  archivedAt               DateTime?
  archivedBy               String?
  archivedReason           String?
  isVariantTemplate        Boolean                 @default(false)
  parentProductId          String?
  variantAttributes        Json?
  productVariantTemplateId String?
  boms                     BOM[]
  inventoryMovements       InventoryMovement[]
  orderLines               OrderLine[]
  category                 ProductCategory         @relation(fields: [categoryId], references: [id])
  parentProduct            Product?                @relation("ProductVariants", fields: [parentProductId], references: [id])
  childVariants            Product[]               @relation("ProductVariants")
  ProductVariantTemplate   ProductVariantTemplate? @relation(fields: [productVariantTemplateId], references: [id])
  ProductSizeVariant       ProductSizeVariant[]
  variants                 ProductVariant[]
  productionBatches        ProductionBatch[]
  productionOrders         ProductionOrder[]
  salesInvoiceItems        SalesInvoiceItem[]
}

model ProductVariantTemplate {
  id              String    @id @default(cuid())
  name            String
  description     String?
  availableSizes  Json
  sizeMapping     Json
  availableColors Json
  colorMapping    Json
  baseBOMId       String?
  bomInheritance  Json
  pricingRules    Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  modifiedBy      String?
  products        Product[]
  baseBOM         BOM?      @relation("TemplateBOM", fields: [baseBOMId], references: [id])
}

model ProductVariant {
  id                   String              @id @default(cuid())
  productId            String
  sku                  String              @unique
  sizeName             String?
  sizeCode             String?
  colorName            String?
  colorCode            String?
  styleName            String?
  materialName         String?
  unitCost             Decimal             @db.Decimal(10, 2)
  sellingPrice         Decimal             @db.Decimal(10, 2)
  currentStock         Int                 @default(0)
  minimumStockLevel    Int                 @default(0)
  expectedStock        Int                 @default(0)
  committedStock       Int                 @default(0)
  displayName          String
  isActive             Boolean             @default(true)
  sortOrder            Int                 @default(0)
  inheritBOMFromParent Boolean             @default(true)
  bomOverrides         Json?
  variantGroup         String?
  isTemplate           Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            String?
  modifiedBy           String?
  OrderLine            OrderLine[]
  orderLines           OrderLineVariant[]
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  boms                 ProductVariantBOM[]
  ProductionOrder      ProductionOrder[]

  @@unique([productId, sizeName, colorName])
  @@index([productId])
  @@index([sizeName])
  @@index([colorName])
  @@index([sku])
  @@index([variantGroup])
}

model ProductVariantBOM {
  id               String         @id @default(cuid())
  productVariantId String
  materialId       String
  quantityNeeded   Decimal        @db.Decimal(10, 3)
  wastePercentage  Decimal        @db.Decimal(5, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  modifiedBy       String?
  material         Material       @relation(fields: [materialId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, materialId])
  @@index([productVariantId])
  @@index([materialId])
}

model OrderLineVariant {
  id          String         @id @default(cuid())
  orderLineId String
  variantId   String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderLine   OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orderLineId, variantId])
  @@index([orderLineId])
  @@index([variantId])
}

model ProductSizeVariant {
  id                String                  @id @default(cuid())
  productId         String
  sizeName          String
  sizeCode          String
  unitCost          Decimal                 @db.Decimal(10, 2)
  sellingPrice      Decimal                 @db.Decimal(10, 2)
  currentStock      Int                     @default(0)
  minimumStockLevel Int                     @default(0)
  isActive          Boolean                 @default(true)
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdBy         String?
  modifiedBy        String?
  isDeprecated      Boolean                 @default(false)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  boms              ProductSizeVariantBOM[]

  @@unique([productId, sizeName])
  @@index([productId])
  @@index([sizeName])
}

model ProductSizeVariantBOM {
  id                   String             @id @default(cuid())
  productSizeVariantId String
  materialId           String
  quantityNeeded       Decimal            @db.Decimal(10, 3)
  wastePercentage      Decimal            @db.Decimal(5, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            String?
  modifiedBy           String?
  isDeprecated         Boolean            @default(false)
  material             Material           @relation(fields: [materialId], references: [id])
  productSizeVariant   ProductSizeVariant @relation(fields: [productSizeVariantId], references: [id], onDelete: Cascade)

  @@unique([productSizeVariantId, materialId])
  @@index([productSizeVariantId])
  @@index([materialId])
}

model Material {
  id                    String                          @id @default(cuid())
  name                  String
  typeId                String
  unitOfMeasureId       String
  costPerUnit           Decimal                         @db.Decimal(10, 2)
  currentStock          Int
  minimumStockLevel     Int
  committedStock        Int                             @default(0)
  availableStock        Int                             @default(0)
  leadTime              Int
  supplierId            String
  status                Status                          @default(ACTIVE)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  createdBy             String?
  modifiedBy            String?
  notes                 String?
  sku                   String                          @unique
  archivedAt            DateTime?
  archivedBy            String?
  archivedReason        String?
  boms                  BOM[]
  costVariances         CostVariance[]
  inventoryMovements    InventoryMovement[]
  supplier              Supplier                        @relation(fields: [supplierId], references: [id])
  type                  MaterialType                    @relation(fields: [typeId], references: [id])
  unitOfMeasure         UnitOfMeasure                   @relation(fields: [unitOfMeasureId], references: [id])
  reservations          MaterialReservation[]
  ProductSizeVariantBOM ProductSizeVariantBOM[]
  ProductVariantBOM     ProductVariantBOM[]
  ProductionBOM         ProductionBOM[]
  consumptions          ProductionMaterialConsumption[]
  purchaseOrderLines    PurchaseOrderLine[]
  SalesInvoiceItem      SalesInvoiceItem[]
}

model BOM {
  id                     String                   @id @default(cuid())
  productId              String
  materialId             String
  quantityNeeded         Decimal                  @db.Decimal(10, 3)
  wastePercentage        Decimal                  @db.Decimal(5, 2)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              String?
  modifiedBy             String?
  material               Material                 @relation(fields: [materialId], references: [id])
  product                Product                  @relation(fields: [productId], references: [id])
  ProductVariantTemplate ProductVariantTemplate[] @relation("TemplateBOM")
  ProductionBOM          ProductionBOM[]

  @@index([productId])
  @@index([materialId])
}

model ProductionBOM {
  id                String          @id @default(cuid())
  productionOrderId String
  materialId        String
  originalBOMId     String?
  quantityNeeded    Decimal         @db.Decimal(10, 3)
  wastePercentage   Decimal         @db.Decimal(5, 2)
  adjustedQuantity  Decimal?        @db.Decimal(10, 3)
  adjustmentReason  String?
  isAdjusted        Boolean         @default(false)
  unitCost          Decimal         @db.Decimal(10, 4)
  totalCost         Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  material          Material        @relation(fields: [materialId], references: [id])
  originalBOM       BOM?            @relation(fields: [originalBOMId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, materialId])
  @@index([productionOrderId])
  @@index([materialId])
  @@index([isAdjusted])
}

model ProductionOrder {
  id                    String                          @id @default(cuid())
  productId             String
  productVariantId      String?
  quantity              Int
  startDate             DateTime
  dueDate               DateTime
  status                Status                          @default(ACTIVE)
  priority              Priority                        @default(MEDIUM)
  customerOrderId       String?
  notes                 String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  createdBy             String?
  modifiedBy            String?
  plannedMaterialCost   Decimal                         @default(0) @db.Decimal(12, 2)
  actualMaterialCost    Decimal                         @default(0) @db.Decimal(12, 2)
  materialVariance      Decimal                         @default(0) @db.Decimal(12, 2)
  completedQuantity     Int                             @default(0)
  completedAt           DateTime?
  billingStatements     BillingStatement[]
  costVariances         CostVariance[]
  delivery              DeliveryAssignment?
  materialReservations  MaterialReservation[]
  operations            Operation[]
  ProductionBOM         ProductionBOM[]
  productionBatches     ProductionBatch[]
  materialConsumptions  ProductionMaterialConsumption[]
  createdByUser         User?                           @relation("CreatedBy", fields: [createdBy], references: [id])
  customerOrder         CustomerOrder?                  @relation(fields: [customerOrderId], references: [id])
  modifiedByUser        User?                           @relation("ModifiedBy", fields: [modifiedBy], references: [id])
  product               Product                         @relation(fields: [productId], references: [id])
  productVariant        ProductVariant?                 @relation(fields: [productVariantId], references: [id])
  productionHistoryLogs ProductionOrderHistoryLog[]
  qualityChecks         QualityCheck[]

  @@index([productVariantId])
}

model WorkCenter {
  id               String                 @id @default(cuid())
  name             String
  description      String?
  capacityPerHour  Int
  operatingHours   Int
  efficiencyRate   Decimal                @db.Decimal(5, 2)
  status           Status                 @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        String?
  modifiedBy       String?
  locations        Location[]
  materialRequests MaterialRequest[]
  operations       Operation[]
  UserWorkCenter   UserWorkCenter[]
  userAssignments  WorkCenterAssignment[]
}

model Operation {
  id                String          @id @default(cuid())
  workCenterId      String
  productionOrderId String
  startTime         DateTime
  endTime           DateTime
  status            Status          @default(ACTIVE)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  assignedToId      String?
  performedById     String?
  cost              Decimal         @db.Decimal(10, 2)
  assignedTo        User?           @relation("AssignedOperations", fields: [assignedToId], references: [id])
  performedBy       User?           @relation("PerformedOperations", fields: [performedById], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  workCenter        WorkCenter      @relation(fields: [workCenterId], references: [id])
}

model QualityCheck {
  id                String          @id @default(cuid())
  productionOrderId String
  inspectorId       String
  checkDate         DateTime
  status            Status          @default(ACTIVE)
  defectsFound      String?
  actionTaken       String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  inspector         User            @relation("Inspections", fields: [inspectorId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  contactPerson  String
  email          String
  phone          String
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  paymentTerms   String?
  leadTime       Int
  status         Status          @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  modifiedBy     String?
  materials      Material[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  supplierId       String
  orderDate        DateTime
  expectedDelivery DateTime
  status           Status              @default(ACTIVE)
  totalAmount      Decimal             @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?
  modifiedBy       String?
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  orderLines       PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  materialId    String
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  status        Status        @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  modifiedBy    String?
  material      Material      @relation(fields: [materialId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
}

model Customer {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  contactPerson     String
  email             String
  phone             String
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  tinNumber         String?
  creditLimit       Decimal?           @db.Decimal(10, 2)
  paymentTerms      String?
  status            Status             @default(ACTIVE)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  modifiedBy        String?
  billingStatements BillingStatement[]
  orders            CustomerOrder[]
}

model CustomerOrder {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  customerId        String
  orderDate         DateTime
  requiredDate      DateTime
  status            Status             @default(ACTIVE)
  totalAmount       Decimal            @db.Decimal(10, 2)
  shippingAddress   String?
  billingAddress    String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  modifiedBy        String?
  billingStatements BillingStatement[]
  customer          Customer           @relation(fields: [customerId], references: [id])
  orderLines        OrderLine[]
  productionOrders  ProductionOrder[]
  transaction       Transaction[]
}

model OrderLine {
  id                 String             @id @default(cuid())
  orderId            String
  productId          String
  productVariantId   String?
  quantity           Int
  unitPrice          Decimal            @db.Decimal(10, 2)
  status             Status             @default(ACTIVE)
  notes              String?
  // Fulfillment tracking fields
  fulfillmentType    FulfillmentType?   @default(PENDING)
  stockAllocated     Int?               @default(0)
  productionQuantity Int?               @default(0)
  fulfillmentStatus  FulfillmentStatus? @default(PENDING)
  allocatedAt        DateTime?
  fulfilledAt        DateTime?
  // Audit fields
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?
  modifiedBy         String?
  // Relationships
  customerOrder      CustomerOrder      @relation(fields: [orderId], references: [id])
  product            Product            @relation(fields: [productId], references: [id])
  productVariant     ProductVariant?    @relation(fields: [productVariantId], references: [id])
  variants           OrderLineVariant[]

  @@index([fulfillmentStatus])
  @@index([fulfillmentType])
  @@index([allocatedAt])
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  handledBy     String
  paymentDate   DateTime
  status        Status        @default(COMPLETED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  handledByUser User          @relation(fields: [handledBy], references: [id])
  customerOrder CustomerOrder @relation(fields: [orderId], references: [id])
}

model Inspector {
  inspectorId        String   @id @default(cuid())
  userId             String?  @unique
  firstName          String
  lastName           String
  email              String   @unique
  phoneNumber        String?
  department         String?
  specialization     String?
  certificationLevel String?
  yearsOfExperience  Int?
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  modifiedBy         String?
  user               User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([isActive])
}

model Alert {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  status     String
  priority   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  modifiedBy String?
}

model UserWorkCenter {
  id            String     @id @default(cuid())
  userId        String
  workCenterId  String
  isResponsible Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workCenter    WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([userId, workCenterId])
}

model MaterialRequest {
  id                String                @id @default(cuid())
  requestDate       DateTime              @default(now())
  requestedById     String
  workCenterId      String
  status            String                @default("PENDING")
  priority          String                @default("MEDIUM")
  requiredDate      DateTime
  approvedById      String?
  approvedDate      DateTime?
  fulfilledDate     DateTime?
  notes             String?
  productionOrderId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  approvedBy        User?                 @relation("ApprovedMaterials", fields: [approvedById], references: [id])
  requestedBy       User                  @relation("RequestedMaterials", fields: [requestedById], references: [id])
  workCenter        WorkCenter            @relation(fields: [workCenterId], references: [id])
  items             MaterialRequestItem[]
}

model MaterialRequestItem {
  id                String          @id @default(cuid())
  materialRequestId String
  inventoryItemId   String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int?
  unit              String
  notes             String?
  status            String          @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id                   String                 @id @default(cuid())
  sku                  String                 @unique
  name                 String
  description          String?
  materialType         String                 @default("COMPONENT")
  locationId           String
  unit                 String
  currentStock         Int                    @default(0)
  minimumStockLevel    Int                    @default(0)
  criticalStockLevel   Int                    @default(0)
  reorderQuantity      Int?
  leadTime             Int?
  cost                 Decimal                @db.Decimal(10, 2)
  qrCode               String?
  barcode              String?
  image                String?
  notes                String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdBy            String?
  modifiedBy           String?
  issueReports         InventoryIssueReport[]
  location             Location               @relation(fields: [locationId], references: [id])
  materialRequestItems MaterialRequestItem[]
  SalesInvoiceItem     SalesInvoiceItem[]
}

model Location {
  id             String          @id @default(cuid())
  name           String
  description    String?
  locationType   String          @default("STORAGE")
  isPublic       Boolean         @default(false)
  workCenterId   String?
  capacity       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  modifiedBy     String?
  inventoryItems InventoryItem[]
  workCenter     WorkCenter?     @relation(fields: [workCenterId], references: [id])
}

model InventoryIssueReport {
  id              String        @id @default(cuid())
  inventoryItemId String
  reportType      String
  reportDate      DateTime      @default(now())
  reportedById    String
  description     String
  severity        String
  status          String        @default("OPEN")
  resolvedDate    DateTime?
  resolution      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  reportedBy      User          @relation(fields: [reportedById], references: [id])
}

model DeliveryAssignment {
  id                String          @id @default(cuid())
  productionOrderId String          @unique
  userId            String
  scheduledDate     DateTime?
  status            Status          @default(PENDING)
  notes             String?
  deliveryAddress   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  userId    String
  details   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model MaterialReservation {
  id                String            @id @default(cuid())
  productionOrderId String
  materialId        String
  quantityReserved  Decimal           @db.Decimal(10, 3)
  quantityConsumed  Decimal           @default(0) @db.Decimal(10, 3)
  quantityReleased  Decimal           @default(0) @db.Decimal(10, 3)
  status            ReservationStatus @default(RESERVED)
  reservedAt        DateTime          @default(now())
  consumedAt        DateTime?
  releasedAt        DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  modifiedBy        String?
  material          Material          @relation(fields: [materialId], references: [id])
  productionOrder   ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, materialId])
  @@index([status])
  @@index([reservedAt])
}

model ProductionMaterialConsumption {
  id                String          @id @default(cuid())
  productionOrderId String
  materialId        String
  plannedQuantity   Decimal         @db.Decimal(10, 3)
  actualQuantity    Decimal         @db.Decimal(10, 3)
  wasteQuantity     Decimal         @default(0) @db.Decimal(10, 3)
  unitCost          Decimal         @db.Decimal(10, 4)
  totalCost         Decimal         @db.Decimal(12, 2)
  consumedBy        String
  consumedAt        DateTime        @default(now())
  batchNumber       String?
  lotNumber         String?
  expiryDate        DateTime?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  consumedByUser    User            @relation(fields: [consumedBy], references: [id])
  material          Material        @relation(fields: [materialId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([materialId])
  @@index([consumedAt])
}

model InventoryMovement {
  id              String       @id @default(cuid())
  materialId      String?
  productId       String?
  movementType    MovementType
  quantity        Decimal      @db.Decimal(10, 3)
  previousStock   Decimal      @db.Decimal(10, 3)
  newStock        Decimal      @db.Decimal(10, 3)
  unitCost        Decimal?     @db.Decimal(10, 4)
  totalValue      Decimal?     @db.Decimal(12, 2)
  referenceId     String?
  referenceType   String?
  locationFrom    String?
  locationTo      String?
  performedBy     String
  approvedBy      String?
  transactionDate DateTime     @default(now())
  notes           String?
  batchNumber     String?
  lotNumber       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approvedByUser  User?        @relation("ApprovedMovements", fields: [approvedBy], references: [id])
  material        Material?    @relation(fields: [materialId], references: [id])
  performedByUser User         @relation("PerformedMovements", fields: [performedBy], references: [id])
  product         Product?     @relation(fields: [productId], references: [id])

  @@index([movementType])
  @@index([transactionDate])
  @@index([materialId])
  @@index([productId])
  @@index([referenceId, referenceType])
}

model ProductionBatch {
  id                String          @id @default(cuid())
  batchNumber       String          @unique
  productionOrderId String
  productId         String
  plannedQuantity   Int
  producedQuantity  Int             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  status            BatchStatus     @default(PLANNED)
  qualityStatus     QualityStatus   @default(PENDING)
  totalMaterialCost Decimal         @default(0) @db.Decimal(12, 2)
  totalLaborCost    Decimal         @default(0) @db.Decimal(12, 2)
  totalOverheadCost Decimal         @default(0) @db.Decimal(12, 2)
  unitCost          Decimal         @default(0) @db.Decimal(10, 4)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  product           Product         @relation(fields: [productId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([batchNumber])
  @@index([status])
  @@index([productionOrderId])
}

model CostVariance {
  id                String          @id @default(cuid())
  productionOrderId String
  materialId        String?
  varianceType      VarianceType
  plannedCost       Decimal         @db.Decimal(12, 2)
  actualCost        Decimal         @db.Decimal(12, 2)
  variance          Decimal         @db.Decimal(12, 2)
  variancePercent   Decimal         @db.Decimal(8, 4)
  explanation       String?
  investigatedBy    String?
  investigatedAt    DateTime?
  resolution        String?
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  investigator      User?           @relation(fields: [investigatedBy], references: [id])
  material          Material?       @relation(fields: [materialId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([varianceType])
  @@index([productionOrderId])
}

model BillingStatement {
  id                String            @id @default(cuid())
  statementNumber   String            @unique
  customerId        String?
  customerOrderId   String?
  customerName      String
  productionOrderId String?
  totalAmount       Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  netAmount         Decimal           @db.Decimal(12, 2)
  status            BillingStatus     @default(DRAFT)
  billingDate       DateTime          @default(now())
  dueDate           DateTime?
  paidDate          DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  modifiedBy        String?
  createdByUser     User?             @relation("CreatedBillingStatements", fields: [createdBy], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id])
  customerOrder     CustomerOrder?    @relation(fields: [customerOrderId], references: [id])
  modifiedByUser    User?             @relation("ModifiedBillingStatements", fields: [modifiedBy], references: [id])
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  deliveryReceipts  DeliveryReceipt[]
  salesInvoice      SalesInvoice?     @relation("BillingToInvoice")

  @@index([customerId])
  @@index([customerName])
  @@index([customerOrderId])
  @@index([productionOrderId])
  @@index([status])
  @@index([billingDate])
}

model DeliveryReceipt {
  id                 String           @id @default(cuid())
  receiptNumber      String           @unique
  billingStatementId String
  deliveryDate       DateTime
  deliveryAddress    String
  receivedBy         String
  receivedByTitle    String?
  signatureImage     String?
  photoEvidence      String?
  trackingNumber     String?
  courierService     String?
  deliveryStatus     DeliveryStatus   @default(DELIVERED)
  deliveryNotes      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdBy          String?
  modifiedBy         String?
  billingStatement   BillingStatement @relation(fields: [billingStatementId], references: [id], onDelete: Cascade)
  createdByUser      User?            @relation("CreatedDeliveryReceipts", fields: [createdBy], references: [id])
  modifiedByUser     User?            @relation("ModifiedDeliveryReceipts", fields: [modifiedBy], references: [id])

  @@index([deliveryDate])
  @@index([deliveryStatus])
  @@index([billingStatementId])
}

model SalesInvoice {
  id                 String             @id @default(cuid())
  invoiceNumber      String             @unique
  billingStatementId String             @unique
  invoiceDate        DateTime           @default(now())
  subtotal           Decimal            @db.Decimal(12, 2)
  taxRate            Decimal            @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal            @db.Decimal(12, 2)
  paymentTerms       String?
  dueDate            DateTime?
  status             InvoiceStatus      @default(DRAFT)
  poNumber           String?
  terms              String?
  footerNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?
  modifiedBy         String?
  billingStatement   BillingStatement   @relation("BillingToInvoice", fields: [billingStatementId], references: [id], onDelete: Cascade)
  createdByUser      User?              @relation("CreatedSalesInvoices", fields: [createdBy], references: [id])
  modifiedByUser     User?              @relation("ModifiedSalesInvoices", fields: [modifiedBy], references: [id])
  invoiceItems       SalesInvoiceItem[]

  @@index([invoiceDate])
  @@index([status])
  @@index([dueDate])
  @@index([billingStatementId])
}

model SalesInvoiceItem {
  id              String         @id @default(cuid())
  salesInvoiceId  String
  productId       String?
  description     String
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(10, 2)
  totalPrice      Decimal        @db.Decimal(12, 2)
  productCode     String?
  unit            String?
  discountPercent Decimal?       @default(0) @db.Decimal(5, 2)
  taxable         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  materialId      String?
  inventoryItemId String?
  InventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  Material        Material?      @relation(fields: [materialId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  salesInvoice    SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId])
  @@index([productId])
}

model ShareableLink {
  id             String           @id @default(cuid())
  token          String           @unique
  documentType   ShareableDocType
  documentId     String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  isRevoked      Boolean          @default(false)
  revokedAt      DateTime?
  createdBy      String
  accessCount    Int              @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdByUser  User             @relation(fields: [createdBy], references: [id])

  @@index([token])
  @@index([documentType, documentId])
  @@index([expiresAt])
  @@index([isRevoked])
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  OTHER
}

enum Role {
  ADMIN
  WORKER
  INSPECTOR
  DELIVERY
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  ON_HOLD
  FAILED
  SUBCON
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum ReservationStatus {
  RESERVED
  PARTIAL
  CONSUMED
  RELEASED
  EXPIRED
}

enum MovementType {
  MATERIAL_RESERVATION
  MATERIAL_CONSUMPTION
  MATERIAL_RETURN
  MATERIAL_RECEIPT
  MATERIAL_TRANSFER
  MATERIAL_ADJUSTMENT
  MATERIAL_WASTE
  PRODUCTION_COMPLETE
  PRODUCT_SHIPMENT
  PRODUCT_RETURN
  PRODUCT_ADJUSTMENT
  PRODUCT_TRANSFER
  CYCLE_COUNT
  DAMAGE_WRITE_OFF
  EXPIRY_WRITE_OFF
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
  QUALITY_HOLD
}

enum QualityStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
  REWORK
}

enum VarianceType {
  MATERIAL_PRICE
  MATERIAL_USAGE
  LABOR_RATE
  LABOR_EFFICIENCY
  OVERHEAD
  TOTAL_COST
}

enum BillingStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
  PARTIAL
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
  PARTIAL
}

enum ShareableDocType {
  BILLING_STATEMENT
  SALES_INVOICE
  DELIVERY_RECEIPT
}

enum FulfillmentType {
  PENDING
  STOCK
  PRODUCTION
  HYBRID
}

enum FulfillmentStatus {
  PENDING
  ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model CustomerOrderArchive {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  orderNumber        String
  customerName       String
  archivedAt         DateTime  @default(now())
  archivedBy         String
  archivedByUser     User      @relation("ArchivedOrders", fields: [archivedBy], references: [id])
  archiveReason      String
  originalData       Json // Complete order snapshot
  fulfillmentSummary Json // Fulfillment summary at time of archiving
  billingStatus      String
  totalValue         Decimal   @db.Decimal(12, 2)
  restorable         Boolean   @default(true)
  restoredAt         DateTime?
  restoredBy         String?
  restoredByUser     User?     @relation("RestoredOrders", fields: [restoredBy], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([archivedAt])
  @@index([customerName])
  @@index([archiveReason])
  @@index([billingStatus])
  @@index([totalValue])
}

// Customer Support System Models
model SupportTicket {
  id          String             @id @default(cuid())
  userId      String
  title       String
  description String
  status      SupportStatus      @default(OPEN)
  priority    SupportPriority    @default(MEDIUM)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  resolvedAt  DateTime?
  user        User               @relation("UserSupportTickets", fields: [userId], references: [id])
  messages    SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation("UserSupportMessages", fields: [userId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
