generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  email                    String                 @unique
  password                 String
  role                     Role                   @default(WORKER) // Updated default
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  createdBy                String?
  lastLoginAt              DateTime?
  modifiedBy               String?
  status                   UserStatus             @default(ACTIVE)
  Transaction              Transaction[]
  profile                  UserProfile?
  // New relationships
  workCenterAssignments    WorkCenterAssignment[]
  assignedOperations       Operation[]            @relation("AssignedOperations")
  performedOperations      Operation[]            @relation("PerformedOperations")
  inspections              QualityCheck[]         @relation("Inspections")
  createdProductionOrders  ProductionOrder[]      @relation("CreatedBy")
  modifiedProductionOrders ProductionOrder[]      @relation("ModifiedBy")
  UserWorkCenter           UserWorkCenter[]
  inspector                Inspector?
  requestedMaterials       MaterialRequest[]      @relation("RequestedMaterials")
  approvedMaterials        MaterialRequest[]      @relation("ApprovedMaterials")
  reportedIssues           InventoryIssueReport[]
  deliveryAssignments      DeliveryAssignment[]
  activityLogs             ActivityLog[] // Add relation to ActivityLog

  // MRP Enhancement Relations
  materialConsumptions  ProductionMaterialConsumption[]
  performedMovements    InventoryMovement[]             @relation("PerformedMovements")
  approvedMovements     InventoryMovement[]             @relation("ApprovedMovements")
  investigatedVariances CostVariance[]
}

model WorkCenterAssignment {
  id           String     @id @default(cuid())
  userId       String
  workCenterId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       Status     @default(ACTIVE)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([userId, workCenterId])
}

model UserProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  department       String?
  position         String?
  employeeId       String?
  dateOfBirth      DateTime?
  gender           Gender?
  avatar           String?
  bio              String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emergencyContact EmergencyContact?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id             String      @id @default(cuid())
  profileId      String      @unique
  name           String
  relationship   String
  phoneNumber    String
  altPhoneNumber String?
  email          String?
  address        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userProfile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  modifiedBy  String?
  products    Product[]
}

model MaterialType {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  modifiedBy  String?
  materials   Material[]
}

model UnitOfMeasure {
  id          String     @id @default(cuid())
  name        String     @unique
  symbol      String
  description String?
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  modifiedBy  String?
  materials   Material[]
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  description       String?
  categoryId        String
  sizeRange         String[] // Keep for legacy/simple products
  colorOptions      String[] // Keep for legacy/simple products
  unitCost          Decimal  @db.Decimal(10, 2) // Base cost
  sellingPrice      Decimal  @db.Decimal(10, 2) // Base price
  minimumStockLevel Int
  currentStock      Int
  expectedStock     Int      @default(0)
  committedStock    Int      @default(0)
  calculatedStock   Int      @default(0)
  leadTime          Int
  hasVariants       Boolean  @default(false) // Changed from hasSizeVariants to hasVariants
  status            Status   @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  modifiedBy        String?

  // Enhanced Variant Management
  isVariantTemplate Boolean @default(false) // Master product for variants
  parentProductId   String? // Link to parent product for variants
  variantAttributes Json? // Flexible variant properties storage

  boms             BOM[]
  orderLines       OrderLine[]
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  productionOrders ProductionOrder[]
  variants         ProductVariant[] // Enhanced relation for all variants

  // Enhanced Variant Relations
  parentProduct Product?  @relation("ProductVariants", fields: [parentProductId], references: [id])
  childVariants Product[] @relation("ProductVariants")

  // MRP Enhancement Relations
  inventoryMovements       InventoryMovement[]
  productionBatches        ProductionBatch[]
  ProductSizeVariant       ProductSizeVariant[]
  ProductVariantTemplate   ProductVariantTemplate? @relation(fields: [productVariantTemplateId], references: [id])
  productVariantTemplateId String?
}

// New ProductVariantTemplate model for variant configuration
model ProductVariantTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Size Configuration
  availableSizes Json // ["XS", "S", "M", "L", "XL", "XXL"]
  sizeMapping    Json // Size-specific multipliers/overrides

  // Color Configuration  
  availableColors Json // [{"name": "Red", "code": "#FF0000"}, ...]
  colorMapping    Json // Color-specific pricing/materials

  // BOM Configuration
  baseBOMId      String?
  bomInheritance Json // Rules for BOM inheritance

  // Pricing Rules
  pricingRules Json // Size/color-based pricing rules

  // Metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  modifiedBy String?

  // Relations
  products Product[]
  baseBOM  BOM?      @relation("TemplateBOM", fields: [baseBOMId], references: [id])
}

// Enhanced model for comprehensive product variants (size + color + other attributes)
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique // Unique SKU for each variant (e.g., SHIRT-001-M-RED)

  // Variant Attributes
  sizeName     String? // XS, S, M, L, XL, XXL, etc.
  sizeCode     String? // Size code for processing
  colorName    String? // Red, Blue, Green, etc.
  colorCode    String? // Color code (hex, pantone, etc.)
  styleName    String? // Optional: Style variant (Regular, Slim, etc.)
  materialName String? // Optional: Material variant (Cotton, Polyester, etc.)

  // Pricing and Stock
  unitCost          Decimal @db.Decimal(10, 2) // Variant-specific cost
  sellingPrice      Decimal @db.Decimal(10, 2) // Variant-specific price
  currentStock      Int     @default(0)
  minimumStockLevel Int     @default(0)
  expectedStock     Int     @default(0)
  committedStock    Int     @default(0)

  // Display and Organization
  displayName String // Friendly display name (e.g., "Medium Red")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0) // For ordering variants

  // Enhanced BOM Management
  inheritBOMFromParent Boolean @default(true) // Whether to inherit BOM from parent product
  bomOverrides         Json? // JSON field for BOM modifications and overrides
  variantGroup         String? // Group related variants together
  isTemplate           Boolean @default(false) // Whether this variant is a template for others

  // Metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  modifiedBy String?

  // Relations
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  boms            ProductVariantBOM[] // Variant-specific BOMs
  orderLines      OrderLineVariant[] // Orders for specific variants
  OrderLine       OrderLine[]
  ProductionOrder ProductionOrder[]

  @@unique([productId, sizeName, colorName]) // Ensure unique size+color combinations per product
  @@index([productId])
  @@index([sizeName])
  @@index([colorName])
  @@index([sku])
  @@index([variantGroup])
}

// Variant-specific BOM (replaces ProductSizeVariantBOM)
model ProductVariantBOM {
  id               String   @id @default(cuid())
  productVariantId String
  materialId       String
  quantityNeeded   Decimal  @db.Decimal(10, 3)
  wastePercentage  Decimal  @db.Decimal(5, 2)
  notes            String? // Notes about material usage for this variant
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  modifiedBy       String?

  // Relations
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id])

  @@unique([productVariantId, materialId])
  @@index([productVariantId])
  @@index([materialId])
}

// Enhanced OrderLine to support specific variants
model OrderLineVariant {
  id          String   @id @default(cuid())
  orderLineId String
  variantId   String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  orderLine OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orderLineId, variantId])
  @@index([orderLineId])
  @@index([variantId])
}

// DEPRECATED: Keep for backward compatibility, but mark as deprecated
// Will be migrated to ProductVariant gradually
model ProductSizeVariant {
  id                String   @id @default(cuid())
  productId         String
  sizeName          String // XS, S, M, L, XL, XXL, etc.
  sizeCode          String // Size code for SKU generation
  unitCost          Decimal  @db.Decimal(10, 2) // Size-specific cost
  sellingPrice      Decimal  @db.Decimal(10, 2) // Size-specific price
  currentStock      Int      @default(0)
  minimumStockLevel Int      @default(0)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0) // For ordering sizes (XS=1, S=2, etc.)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  modifiedBy        String?
  // DEPRECATED: Will be migrated to ProductVariant
  isDeprecated      Boolean  @default(false)

  // Relations
  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  boms    ProductSizeVariantBOM[] // Size-specific BOMs

  @@unique([productId, sizeName])
  @@index([productId])
  @@index([sizeName])
}

// DEPRECATED: Keep for backward compatibility
model ProductSizeVariantBOM {
  id                   String   @id @default(cuid())
  productSizeVariantId String
  materialId           String
  quantityNeeded       Decimal  @db.Decimal(10, 3)
  wastePercentage      Decimal  @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String?
  modifiedBy           String?
  // DEPRECATED: Will be migrated to ProductVariantBOM
  isDeprecated         Boolean  @default(false)

  // Relations
  productSizeVariant ProductSizeVariant @relation(fields: [productSizeVariantId], references: [id], onDelete: Cascade)
  material           Material           @relation(fields: [materialId], references: [id])

  @@unique([productSizeVariantId, materialId])
  @@index([productSizeVariantId])
  @@index([materialId])
}

model Material {
  id                 String              @id @default(cuid())
  name               String
  typeId             String
  unitOfMeasureId    String
  costPerUnit        Decimal             @db.Decimal(10, 2)
  currentStock       Int
  minimumStockLevel  Int
  committedStock     Int                 @default(0)
  availableStock     Int                 @default(0) // currentStock - committedStock (calculated)
  leadTime           Int
  supplierId         String
  status             Status              @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String?
  modifiedBy         String?
  notes              String?
  sku                String              @unique
  boms               BOM[]
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  type               MaterialType        @relation(fields: [typeId], references: [id])
  unitOfMeasure      UnitOfMeasure       @relation(fields: [unitOfMeasureId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]

  // MRP Enhancement Relations
  reservations          MaterialReservation[]
  consumptions          ProductionMaterialConsumption[]
  inventoryMovements    InventoryMovement[]
  costVariances         CostVariance[]
  ProductionBOM         ProductionBOM[]
  ProductSizeVariantBOM ProductSizeVariantBOM[]
  ProductVariantBOM     ProductVariantBOM[] // New relation
}

model BOM {
  id                     String                   @id @default(cuid())
  productId              String
  materialId             String
  quantityNeeded         Decimal                  @db.Decimal(10, 3)
  wastePercentage        Decimal                  @db.Decimal(5, 2)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              String?
  modifiedBy             String?
  material               Material                 @relation(fields: [materialId], references: [id])
  product                Product                  @relation(fields: [productId], references: [id])
  ProductionBOM          ProductionBOM[]
  ProductVariantTemplate ProductVariantTemplate[] @relation("TemplateBOM")

  @@index([productId])
  @@index([materialId])
}

// Production-specific BOM (Working Copy)
model ProductionBOM {
  id                String   @id @default(cuid())
  productionOrderId String
  materialId        String
  originalBOMId     String? // Reference to the original BOM entry
  quantityNeeded    Decimal  @db.Decimal(10, 3)
  wastePercentage   Decimal  @db.Decimal(5, 2)
  adjustedQuantity  Decimal? @db.Decimal(10, 3) // Adjusted quantity for this production
  adjustmentReason  String? // Reason for quantity adjustment
  isAdjusted        Boolean  @default(false) // Flag to track if quantity was modified
  unitCost          Decimal  @db.Decimal(10, 4) // Cost at time of production
  totalCost         Decimal  @db.Decimal(12, 2) // Calculated total cost
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  modifiedBy        String?

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])
  originalBOM     BOM?            @relation(fields: [originalBOMId], references: [id])

  @@unique([productionOrderId, materialId])
  @@index([productionOrderId])
  @@index([materialId])
  @@index([isAdjusted])
}

model ProductionOrder {
  id               String   @id @default(cuid())
  productId        String
  productVariantId String? // 🆕 ADD: Optional variant tracking for variant-specific production
  quantity         Int
  startDate        DateTime
  dueDate          DateTime
  status           Status   @default(ACTIVE)
  priority         Priority @default(MEDIUM)
  customerOrderId  String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  createdByUser    User?    @relation("CreatedBy", fields: [createdBy], references: [id])
  modifiedBy       String?
  modifiedByUser   User?    @relation("ModifiedBy", fields: [modifiedBy], references: [id])

  // Material Cost Tracking
  plannedMaterialCost Decimal @default(0) @db.Decimal(12, 2)
  actualMaterialCost  Decimal @default(0) @db.Decimal(12, 2)
  materialVariance    Decimal @default(0) @db.Decimal(12, 2)

  // Production Tracking
  completedQuantity Int       @default(0)
  completedAt       DateTime?

  operations     Operation[]
  customerOrder  CustomerOrder?      @relation(fields: [customerOrderId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  productVariant ProductVariant?     @relation(fields: [productVariantId], references: [id]) // 🆕 ADD: Variant relation
  qualityChecks  QualityCheck[]
  delivery       DeliveryAssignment?

  // MRP Enhancement Relations
  materialReservations MaterialReservation[]
  materialConsumptions ProductionMaterialConsumption[]
  productionBatches    ProductionBatch[]
  costVariances        CostVariance[]
  ProductionBOM        ProductionBOM[]

  @@index([productVariantId]) // 🆕 ADD: Index for performance
}

model WorkCenter {
  id               String                 @id @default(cuid())
  name             String
  description      String?
  capacityPerHour  Int
  operatingHours   Int
  efficiencyRate   Decimal                @db.Decimal(5, 2)
  status           Status                 @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        String?
  modifiedBy       String?
  operations       Operation[]
  UserWorkCenter   UserWorkCenter[]
  userAssignments  WorkCenterAssignment[]
  materialRequests MaterialRequest[]
  locations        Location[]
}

model Operation {
  id                String          @id @default(cuid())
  workCenterId      String
  productionOrderId String
  startTime         DateTime
  endTime           DateTime
  status            Status          @default(ACTIVE)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  // New fields for worker assignments
  assignedToId      String?
  performedById     String?
  // Relations
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  workCenter        WorkCenter      @relation(fields: [workCenterId], references: [id])
  assignedTo        User?           @relation("AssignedOperations", fields: [assignedToId], references: [id])
  performedBy       User?           @relation("PerformedOperations", fields: [performedById], references: [id])
  cost              Decimal         @db.Decimal(10, 2)
}

model QualityCheck {
  id                String          @id @default(cuid())
  productionOrderId String
  inspectorId       String
  checkDate         DateTime
  status            Status          @default(ACTIVE)
  defectsFound      String?
  actionTaken       String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  inspector         User            @relation("Inspections", fields: [inspectorId], references: [id])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  contactPerson  String
  email          String
  phone          String
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  paymentTerms   String?
  leadTime       Int
  status         Status          @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  modifiedBy     String?
  materials      Material[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  supplierId       String
  orderDate        DateTime
  expectedDelivery DateTime
  status           Status              @default(ACTIVE)
  totalAmount      Decimal             @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?
  modifiedBy       String?
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  orderLines       PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  materialId    String
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  status        Status        @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  modifiedBy    String?
  material      Material      @relation(fields: [materialId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
}

model Customer {
  id            String          @id @default(cuid())
  name          String
  code          String          @unique
  contactPerson String
  email         String
  phone         String
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  tinNumber     String?         @unique
  creditLimit   Decimal?        @db.Decimal(10, 2)
  paymentTerms  String?
  status        Status          @default(ACTIVE)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     String?
  modifiedBy    String?
  orders        CustomerOrder[]
}

model CustomerOrder {
  id               String            @id @default(cuid())
  orderNumber      String            @unique
  customerId       String
  orderDate        DateTime
  requiredDate     DateTime
  status           Status            @default(ACTIVE)
  totalAmount      Decimal           @db.Decimal(10, 2)
  shippingAddress  String?
  billingAddress   String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  modifiedBy       String?
  customer         Customer          @relation(fields: [customerId], references: [id])
  orderLines       OrderLine[]
  productionOrders ProductionOrder[]
  transaction      Transaction[]
}

model OrderLine {
  id               String             @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String? // Optional field for variant orders
  quantity         Int
  unitPrice        Decimal            @db.Decimal(10, 2)
  status           Status             @default(ACTIVE)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  modifiedBy       String?
  customerOrder    CustomerOrder      @relation(fields: [orderId], references: [id])
  product          Product            @relation(fields: [productId], references: [id])
  productVariant   ProductVariant?    @relation(fields: [productVariantId], references: [id]) // Direct variant relation
  variants         OrderLineVariant[] // Keep for backward compatibility
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  handledBy     String
  paymentDate   DateTime
  status        Status        @default(COMPLETED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  handledByUser User          @relation(fields: [handledBy], references: [id])
  customerOrder CustomerOrder @relation(fields: [orderId], references: [id])
}

model Inspector {
  inspectorId        String   @id @default(cuid())
  userId             String?  @unique
  firstName          String
  lastName           String
  email              String   @unique
  phoneNumber        String?
  department         String?
  specialization     String?
  certificationLevel String?
  yearsOfExperience  Int?
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  modifiedBy         String?
  user               User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([isActive])
}

model Alert {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  status     String
  priority   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  modifiedBy String?
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  OTHER
}

enum Role {
  ADMIN // Administrators and managers
  WORKER // Production workers
  INSPECTOR // Quality control personnel
  DELIVERY // Logistics and delivery personnel
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model UserWorkCenter {
  id            String     @id @default(cuid())
  userId        String
  workCenterId  String
  isResponsible Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workCenter    WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([userId, workCenterId])
}

model MaterialRequest {
  id                String                @id @default(cuid())
  requestDate       DateTime              @default(now())
  requestedById     String
  workCenterId      String
  status            String                @default("PENDING")
  priority          String                @default("MEDIUM")
  requiredDate      DateTime
  approvedById      String?
  approvedDate      DateTime?
  fulfilledDate     DateTime?
  notes             String?
  productionOrderId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  requestedBy       User                  @relation("RequestedMaterials", fields: [requestedById], references: [id])
  approvedBy        User?                 @relation("ApprovedMaterials", fields: [approvedById], references: [id])
  workCenter        WorkCenter            @relation(fields: [workCenterId], references: [id])
  items             MaterialRequestItem[]
}

model MaterialRequestItem {
  id                String          @id @default(cuid())
  materialRequestId String
  inventoryItemId   String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int?
  unit              String
  notes             String?
  status            String          @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])
}

model InventoryItem {
  id                 String   @id @default(cuid())
  sku                String   @unique
  name               String
  description        String?
  materialType       String   @default("COMPONENT")
  locationId         String
  unit               String
  currentStock       Int      @default(0)
  minimumStockLevel  Int      @default(0)
  criticalStockLevel Int      @default(0)
  reorderQuantity    Int?
  leadTime           Int?
  cost               Decimal  @db.Decimal(10, 2)
  qrCode             String?
  barcode            String?
  image              String?
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  modifiedBy         String?

  // Relations
  materialRequestItems MaterialRequestItem[]
  location             Location               @relation(fields: [locationId], references: [id])
  issueReports         InventoryIssueReport[]
}

model Location {
  id           String   @id @default(cuid())
  name         String
  description  String?
  locationType String   @default("STORAGE")
  isPublic     Boolean  @default(false)
  workCenterId String?
  capacity     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  modifiedBy   String?

  // Relation to WorkCenter
  workCenter WorkCenter? @relation(fields: [workCenterId], references: [id])

  // Relation to InventoryItem
  inventoryItems InventoryItem[]
}

model InventoryIssueReport {
  id              String    @id @default(cuid())
  inventoryItemId String
  reportType      String // "LOW_STOCK", "DISCREPANCY", "DAMAGE", "QUALITY", "OTHER"
  reportDate      DateTime  @default(now())
  reportedById    String
  description     String
  severity        String // "LOW", "MEDIUM", "HIGH"
  status          String    @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  resolvedDate    DateTime?
  resolution      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  reportedBy    User          @relation(fields: [reportedById], references: [id])
}

// New model for delivery assignments
model DeliveryAssignment {
  id                String          @id @default(cuid())
  productionOrderId String          @unique
  userId            String
  scheduledDate     DateTime?
  status            Status          @default(PENDING)
  notes             String?
  deliveryAddress   String? // Add specific delivery address
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  modifiedBy        String?
  // Relations
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

// Activity log for tracking system events
model ActivityLog {
  id        String   @id @default(cuid())
  type      String // Type of activity (e.g., PRODUCTION_STATUS_CHANGE, TASK_UPDATE)
  userId    String // User who performed the action
  details   Json // JSON details of the activity
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

// ==============================================
// MRP ENHANCEMENT MODELS - Material Tracking
// ==============================================

// Material Reservations for Production Orders
model MaterialReservation {
  id                String            @id @default(cuid())
  productionOrderId String
  materialId        String
  quantityReserved  Decimal           @db.Decimal(10, 3)
  quantityConsumed  Decimal           @default(0) @db.Decimal(10, 3)
  quantityReleased  Decimal           @default(0) @db.Decimal(10, 3)
  status            ReservationStatus @default(RESERVED)
  reservedAt        DateTime          @default(now())
  consumedAt        DateTime?
  releasedAt        DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  modifiedBy        String?

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])

  @@unique([productionOrderId, materialId])
  @@index([status])
  @@index([reservedAt])
}

// Production Material Consumption Tracking
model ProductionMaterialConsumption {
  id                String    @id @default(cuid())
  productionOrderId String
  materialId        String
  plannedQuantity   Decimal   @db.Decimal(10, 3)
  actualQuantity    Decimal   @db.Decimal(10, 3)
  wasteQuantity     Decimal   @default(0) @db.Decimal(10, 3)
  unitCost          Decimal   @db.Decimal(10, 4)
  totalCost         Decimal   @db.Decimal(12, 2)
  consumedBy        String
  consumedAt        DateTime  @default(now())
  batchNumber       String?
  lotNumber         String?
  expiryDate        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])
  consumedByUser  User            @relation(fields: [consumedBy], references: [id])

  @@index([productionOrderId])
  @@index([materialId])
  @@index([consumedAt])
}

// Comprehensive Inventory Movement Tracking
model InventoryMovement {
  id              String       @id @default(cuid())
  materialId      String?
  productId       String?
  movementType    MovementType
  quantity        Decimal      @db.Decimal(10, 3)
  previousStock   Decimal      @db.Decimal(10, 3)
  newStock        Decimal      @db.Decimal(10, 3)
  unitCost        Decimal?     @db.Decimal(10, 4)
  totalValue      Decimal?     @db.Decimal(12, 2)
  referenceId     String? // production order, purchase order, adjustment ID, etc.
  referenceType   String? // 'PRODUCTION_ORDER', 'PURCHASE_ORDER', 'ADJUSTMENT', etc.
  locationFrom    String?
  locationTo      String?
  performedBy     String
  approvedBy      String?
  transactionDate DateTime     @default(now())
  notes           String?
  batchNumber     String?
  lotNumber       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  material        Material? @relation(fields: [materialId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])
  performedByUser User      @relation("PerformedMovements", fields: [performedBy], references: [id])
  approvedByUser  User?     @relation("ApprovedMovements", fields: [approvedBy], references: [id])

  @@index([movementType])
  @@index([transactionDate])
  @@index([materialId])
  @@index([productId])
  @@index([referenceId, referenceType])
}

// Production Batch Tracking
model ProductionBatch {
  id                String        @id @default(cuid())
  batchNumber       String        @unique
  productionOrderId String
  productId         String
  plannedQuantity   Int
  producedQuantity  Int           @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  status            BatchStatus   @default(PLANNED)
  qualityStatus     QualityStatus @default(PENDING)
  totalMaterialCost Decimal       @default(0) @db.Decimal(12, 2)
  totalLaborCost    Decimal       @default(0) @db.Decimal(12, 2)
  totalOverheadCost Decimal       @default(0) @db.Decimal(12, 2)
  unitCost          Decimal       @default(0) @db.Decimal(10, 4)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         String?
  modifiedBy        String?

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@index([batchNumber])
  @@index([status])
  @@index([productionOrderId])
}

// Cost Variance Tracking
model CostVariance {
  id                String       @id @default(cuid())
  productionOrderId String
  materialId        String?
  varianceType      VarianceType
  plannedCost       Decimal      @db.Decimal(12, 2)
  actualCost        Decimal      @db.Decimal(12, 2)
  variance          Decimal      @db.Decimal(12, 2)
  variancePercent   Decimal      @db.Decimal(8, 4)
  explanation       String?
  investigatedBy    String?
  investigatedAt    DateTime?
  resolution        String?
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material        Material?       @relation(fields: [materialId], references: [id])
  investigator    User?           @relation(fields: [investigatedBy], references: [id])

  @@index([varianceType])
  @@index([productionOrderId])
}

// ==============================================
// ENUMS FOR NEW FUNCTIONALITY
// ==============================================

enum ReservationStatus {
  RESERVED // Materials reserved for production
  PARTIAL // Partially consumed
  CONSUMED // Fully consumed
  RELEASED // Reservation released (cancelled production)
  EXPIRED // Reservation expired
}

enum MovementType {
  // Material movements
  MATERIAL_RESERVATION // Reserve material for production
  MATERIAL_CONSUMPTION // Consume material in production
  MATERIAL_RETURN // Return unused material
  MATERIAL_RECEIPT // Receive material from supplier
  MATERIAL_TRANSFER // Transfer between locations
  MATERIAL_ADJUSTMENT // Manual stock adjustment
  MATERIAL_WASTE // Record material waste

  // Product movements
  PRODUCTION_COMPLETE // Add finished product to inventory
  PRODUCT_SHIPMENT // Ship product to customer
  PRODUCT_RETURN // Product return from customer
  PRODUCT_ADJUSTMENT // Manual product stock adjustment
  PRODUCT_TRANSFER // Transfer between locations

  // Other movements
  CYCLE_COUNT // Physical inventory count adjustment
  DAMAGE_WRITE_OFF // Write off damaged inventory
  EXPIRY_WRITE_OFF // Write off expired inventory
}

enum BatchStatus {
  PLANNED // Batch planned but not started
  IN_PROGRESS // Production in progress
  COMPLETED // Production completed
  ON_HOLD // Production on hold
  CANCELLED // Production cancelled
  QUALITY_HOLD // On hold for quality issues
}

enum QualityStatus {
  PENDING // Quality check pending
  PASSED // Quality check passed
  FAILED // Quality check failed
  CONDITIONAL // Passed with conditions
  REWORK // Requires rework
}

enum VarianceType {
  MATERIAL_PRICE // Material price variance
  MATERIAL_USAGE // Material usage variance
  LABOR_RATE // Labor rate variance
  LABOR_EFFICIENCY // Labor efficiency variance
  OVERHEAD // Overhead variance
  TOTAL_COST // Total cost variance
}
