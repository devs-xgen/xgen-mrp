FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Copy prisma directory
COPY prisma ./prisma/

# Install dependencies and skip postinstall
RUN npm install --ignore-scripts

# Generate Prisma client
RUN npx prisma generate --no-engine

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Start development server
CMD ["npm", "run", "dev"]
