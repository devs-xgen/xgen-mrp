{
  "name": "inventory_system",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:https": "NODE_ENV=development HTTPS=true next dev -p 3001",
    "build": "prisma generate --no-engine && next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "electron-dev": "electron .",
    "prisma:generate": "prisma generate --no-engine",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} prisma/seed.ts",
    "seed:comprehensive": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} scripts/comprehensive-seed.ts",
    "link:inspectors": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} scripts/link-inspectors.ts"
  },
